{
  "version": "0.2.0",
  "configurations": [
    // ── Backend — auto-opens Swagger in browser when ready ────────────────
    {
      "name": "🖥  Backend API (Swagger auto-opens)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "backend: build",
      "program": "${workspaceFolder}/backend/src/NoteApp.API/bin/Debug/net10.0/NoteApp.API.dll",
      "args": [],
      "cwd": "${workspaceFolder}/backend/src/NoteApp.API",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:5001;http://localhost:5000"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on: (https://\\S+)",
        "uriFormat": "https://localhost:5001/swagger"
      }
    },

    // ── Frontend — React Native (requires Metro running) ──────────────────
    {
      "name": "📱 Frontend — Android",
      "type": "reactnative",
      "request": "launch",
      "platform": "android",
      "cwd": "${workspaceFolder}/frontend/NoteAppMobile",
      "env": { "RCT_METRO_PORT": "8081" },
      "preLaunchTask": "frontend: start Metro"
    },
    {
      "name": "📱 Frontend — iOS",
      "type": "reactnative",
      "request": "launch",
      "platform": "ios",
      "cwd": "${workspaceFolder}/frontend/NoteAppMobile",
      "env": { "RCT_METRO_PORT": "8081" },
      "preLaunchTask": "frontend: start Metro"
    },

    // ── Web browser (react-native-web via webpack) ────────────────────────
    {
      "name": "🌐 Frontend — Web Browser (:3000)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/frontend/NoteAppMobile",
      "preLaunchTask": "frontend: start web"
    },

    // ── Metro only — attach to already-running Metro bundler ──────────────
    {
      "name": "📱 Attach to Metro (:8081)",
      "type": "reactnative",
      "request": "attach",
      "cwd": "${workspaceFolder}/frontend/NoteAppMobile",
      "port": 8081
    }
  ],

  // ── Single-click: starts BOTH backend (Swagger) + Metro in separate tabs
  "compounds": [
    {
      "name": "🚀 Full Stack — Backend (Swagger) + Metro",
      "configurations": [
        "🖥  Backend API (Swagger auto-opens)",
        "📱 Frontend — Android"
      ],
      "stopAll": true,
      "presentation": {
        "hidden": false,
        "group": "",
        "order": 1
      }
    },
    {
      "name": "🚀 Full Stack — Backend + Android",
      "configurations": [
        "🖥  Backend API (Swagger auto-opens)",
        "📱 Frontend — Android"
      ],
      "stopAll": true
    },
    {
      "name": "🚀 Full Stack — Backend + Web Browser",
      "configurations": [
        "🖥  Backend API (Swagger auto-opens)",
        "🌐 Frontend — Web Browser (:3000)"
      ],
      "stopAll": true,
      "presentation": {
        "hidden": false,
        "group": "",
        "order": 2
      }
    }
  ]
}
