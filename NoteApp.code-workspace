{
  "folders": [
    {
      "name": "🖥  Backend — ASP.NET Core 10",
      "path": "./backend"
    },
    {
      "name": "📱 Frontend — React Native",
      "path": "./frontend/NoteAppMobile"
    },
    {
      "name": "📋 Root",
      "path": "."
    }
  ],
  "settings": {
    "editor.formatOnSave": true,
    "[csharp]": {
      "editor.defaultFormatter": "ms-dotnettools.csharp"
    },
    "[typescript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[typescriptreact]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "dotnet.defaultSolution": "${workspaceFolder[0]}/NoteApp.sln",
    "react-native.packager.port": 8081,
    "files.exclude": {
      "**/bin": true,
      "**/obj": true,
      "**/node_modules": true,
      "**/.git": false
    },
    "search.exclude": {
      "**/bin": true,
      "**/obj": true,
      "**/node_modules": true
    }
  },
  "extensions": {
    "recommendations": [
      "ms-dotnettools.csdevkit",
      "ms-dotnettools.csharp",
      "ms-dotnettools.vscode-dotnet-runtime",
      "msjsdiag.vscode-react-native",
      "esbenp.prettier-vscode",
      "dbaeumer.vscode-eslint",
      "humao.rest-client",
      "eamodio.gitlens"
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "🖥  Backend API (Swagger auto-opens)",
        "type": "dotnet",
        "request": "launch",
        "projectPath": "${workspaceFolder[0]}/src/NoteApp.API/NoteApp.API.csproj",
        "launchSettingsProfile": "https",
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development",
          "ASPNETCORE_URLS": "https://localhost:5001;http://localhost:5000"
        },
        "serverReadyAction": {
          "action": "openExternally",
          "pattern": "Now listening on: (https://\\S+)",
          "uriFormat": "https://localhost:5001/swagger"
        }
      },
      {
        "name": "📱 Metro Bundler (:8081)",
        "type": "reactnative",
        "request": "launch",
        "platform": "metro",
        "cwd": "${workspaceFolder[1]}"
      },
      {
        "name": "📱 Android",
        "type": "reactnative",
        "request": "launch",
        "platform": "android",
        "cwd": "${workspaceFolder[1]}",
        "env": { "RCT_METRO_PORT": "8081" },
        "preLaunchTask": "frontend: start Metro"
      },
      {
        "name": "📱 iOS",
        "type": "reactnative",
        "request": "launch",
        "platform": "ios",
        "cwd": "${workspaceFolder[1]}",
        "env": { "RCT_METRO_PORT": "8081" },
        "preLaunchTask": "frontend: start Metro"
      }
    ],
    "compounds": [
      {
        "name": "🚀 Full Stack — Backend (Swagger) + Metro",
        "configurations": [
          "🖥  Backend API (Swagger auto-opens)",
          "📱 Metro Bundler (:8081)"
        ],
        "stopAll": true,
        "presentation": { "order": 1 }
      },
      {
        "name": "🚀 Full Stack — Backend + Android",
        "configurations": [
          "🖥  Backend API (Swagger auto-opens)",
          "📱 Android"
        ],
        "stopAll": true,
        "presentation": { "order": 2 }
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "backend: build",
        "type": "shell",
        "command": "dotnet build NoteApp.sln",
        "options": { "cwd": "${workspaceFolder[0]}" },
        "problemMatcher": "$msCompile",
        "group": { "kind": "build", "isDefault": true },
        "presentation": { "reveal": "silent", "panel": "shared" }
      },
      {
        "label": "backend: test with coverage",
        "type": "shell",
        "command": "dotnet test NoteApp.sln --collect:\"XPlat Code Coverage\" --logger trx --results-directory coverage",
        "options": { "cwd": "${workspaceFolder[0]}" },
        "problemMatcher": "$msCompile",
        "group": { "kind": "test", "isDefault": true },
        "presentation": { "reveal": "always", "panel": "dedicated", "tab": "🧪 Tests" }
      },
      {
        "label": "backend: start API",
        "type": "shell",
        "command": "dotnet run --project src/NoteApp.API/NoteApp.API.csproj --launch-profile https",
        "options": { "cwd": "${workspaceFolder[0]}" },
        "isBackground": true,
        "dependsOn": ["backend: build"],
        "problemMatcher": {
          "owner": "dotnet",
          "pattern": [{ "regexp": ".", "file": 1, "location": 2, "message": 3 }],
          "background": {
            "activeOnStart": true,
            "beginsPattern": "Building\\.\\.\\.",
            "endsPattern": "Now listening on:"
          }
        },
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "tab": "🖥  Backend API (:5001)"
        }
      },
      {
        "label": "frontend: install",
        "type": "shell",
        "command": "npm install",
        "options": { "cwd": "${workspaceFolder[1]}" },
        "presentation": { "reveal": "silent", "panel": "shared" }
      },
      {
        "label": "frontend: start Metro",
        "type": "shell",
        "command": "npx react-native start --port 8081 --reset-cache",
        "options": { "cwd": "${workspaceFolder[1]}" },
        "isBackground": true,
        "dependsOn": ["frontend: install"],
        "problemMatcher": {
          "owner": "metro",
          "pattern": [{ "regexp": ".", "file": 1, "location": 2, "message": 3 }],
          "background": {
            "activeOnStart": true,
            "beginsPattern": "Starting Metro Bundler",
            "endsPattern": "Metro waiting on|BUNDLE"
          }
        },
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "tab": "📱 Metro (:8081)"
        }
      },
      {
        "label": "frontend: test",
        "type": "shell",
        "command": "npm test -- --watchAll=false",
        "options": { "cwd": "${workspaceFolder[1]}" },
        "group": { "kind": "test" },
        "presentation": { "reveal": "always", "panel": "dedicated", "tab": "🧪 Tests" }
      },
      {
        "label": "backend: add migration",
        "type": "shell",
        "command": "dotnet ef migrations add ${input:migrationName} --project src/NoteApp.Infrastructure/NoteApp.Infrastructure.csproj --startup-project src/NoteApp.API/NoteApp.API.csproj",
        "options": { "cwd": "${workspaceFolder[0]}" },
        "problemMatcher": [],
        "presentation": { "reveal": "always", "panel": "shared", "tab": "⚙  Migrations" }
      }
    ],
    "inputs": [
      {
        "id": "migrationName",
        "type": "promptString",
        "description": "Migration name (e.g. AddTagsToNotes_20250410)",
        "default": "Migration_"
      }
    ]
  }
}
